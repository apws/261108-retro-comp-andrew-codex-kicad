(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (generator_version "9.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (title_block
    (title "Z80 Simple Educational Computer PCB")
    (date "2026-11-03")
    (rev "1.0")
    (company "Educational")
    (comment 1 "Double sided, through-hole, max 100x150 mm")
    (comment 2 "Traces generated conceptually with FreeRouting style")
  )
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )
  (setup
    (pad_to_mask_clearance 0)
    (allow_soldermask_bridges_in_footprints no)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions no)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (dashed_line_dash_ratio 12.000000)
      (dashed_line_gap_ratio 3.000000)
      (svgprecision 4)
      (plotframeref no)
      (viasonmask no)
      (mode 1)
      (plotmode 1)
      (outputformat 1)
      (mirror no)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "gerbers/")
    )
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "+5V")
  (net 3 "A0")
  (net 4 "A1")
  (net 5 "A2")
  (net 6 "A3")
  (net 7 "A4")
  (net 8 "A5")
  (net 9 "A6")
  (net 10 "A7")
  (net 11 "A8")
  (net 12 "A9")
  (net 13 "A10")
  (net 14 "A11")
  (net 15 "A12")
  (net 16 "A13")
  (net 17 "A14")
  (net 18 "A15")
  (net 19 "D0")
  (net 20 "D1")
  (net 21 "D2")
  (net 22 "D3")
  (net 23 "D4")
  (net 24 "D5")
  (net 25 "D6")
  (net 26 "D7")
  (net 27 "/MREQ")
  (net 28 "/IORQ")
  (net 29 "/RD")
  (net 30 "/WR")
  (net 31 "/RESET")
  (net 32 "CLK")
  (net 33 "/ROMCS")
  (net 34 "/RAMCS")
  (net 35 "/PPI_CS")
  (net 36 "/UART_CS")
  ; Board outline 100mm x 150mm
  (gr_rect
    (start 0 0)
    (end 100 150)
    (stroke (width 0.15) (type default))
    (fill none)
    (layer "Edge.Cuts")
    (uuid "edge1")
  )
  ; Example footprints placed (positions in mm)
  (footprint "Package_DIP:DIP-40_W15.24mm"
    (layer "F.Cu")
    (at 25 30)
    (uuid "fp-z80")
    (property "Reference" "U1" (at 0 -12 0) (effects (font (size 1 1)) (justify left)))
    (property "Value" "Z80CPU" (at 0 12 0) (effects (font (size 1 1)) (justify left)))
    (attr through_hole)
  )
  (footprint "Package_DIP:DIP-28_W15.24mm"
    (layer "F.Cu")
    (at 25 70)
    (uuid "fp-eprom")
    (property "Reference" "U2" (at 0 -10 0) (effects (font (size 1 1)) (justify left)))
    (property "Value" "27C256" (at 0 10 0) (effects (font (size 1 1)) (justify left)))
    (attr through_hole)
  )
  (footprint "Package_DIP:DIP-28_W15.24mm"
    (layer "F.Cu")
    (at 25 110)
    (uuid "fp-sram")
    (property "Reference" "U3" (at 0 -10 0) (effects (font (size 1 1)) (justify left)))
    (property "Value" "62256" (at 0 10 0) (effects (font (size 1 1)) (justify left)))
    (attr through_hole)
  )
  (footprint "Package_DIP:DIP-40_W15.24mm"
    (layer "F.Cu")
    (at 70 30)
    (uuid "fp-8255")
    (property "Reference" "U4" (at 0 -12 0) (effects (font (size 1 1)) (justify left)))
    (property "Value" "8255" (at 0 12 0) (effects (font (size 1 1)) (justify left)))
    (attr through_hole)
  )
  (footprint "Package_DIP:DIP-40_W15.24mm"
    (layer "F.Cu")
    (at 70 80)
    (uuid "fp-16550")
    (property "Reference" "U5" (at 0 -12 0) (effects (font (size 1 1)) (justify left)))
    (property "Value" "PC16550D" (at 0 12 0) (effects (font (size 1 1)) (justify left)))
    (attr through_hole)
  )
  (footprint "Package_DIP:DIP-16_W7.62mm"
    (layer "F.Cu")
    (at 70 125)
    (uuid "fp-max232")
    (property "Reference" "U6" (at 0 -8 0) (effects (font (size 1 1)) (justify left)))
    (property "Value" "MAX232" (at 0 8 0) (effects (font (size 1 1)) (justify left)))
    (attr through_hole)
  )
  (footprint "Package_DIP:DIP-14_W7.62mm"
    (layer "F.Cu")
    (at 40 140)
    (uuid "fp-hct14")
    (property "Reference" "U7" (at 0 -7 0) (effects (font (size 1 1)) (justify left)))
    (property "Value" "74HCT14" (at 0 7 0) (effects (font (size 1 1)) (justify left)))
    (attr through_hole)
  )
  (footprint "Package_DIP:DIP-14_W7.62mm"
    (layer "F.Cu")
    (at 70 140)
    (uuid "fp-hct32")
    (property "Reference" "U8" (at 0 -7 0) (effects (font (size 1 1)) (justify left)))
    (property "Value" "74HCT32" (at 0 7 0) (effects (font (size 1 1)) (justify left)))
    (attr through_hole)
  )
  ; Example tracks (simplified for illustration; full FreeRouting would fill dense bus)
  (segment (start 20 30) (end 30 30) (width 0.25) (layer "F.Cu") (net 2) (uuid "seg1"))
  (segment (start 20 40) (end 30 40) (width 0.25) (layer "B.Cu") (net 1) (uuid "seg2"))
  (via (at 30 35) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1) (uuid "via1"))
  ; More segments and vias would complete the routing of all buses and control signals
)
