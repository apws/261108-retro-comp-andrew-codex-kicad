# Downloaded routing engine and task-local caches are reproducible inputs.
tools/.cache/
__pycache__/
*.py[cod]
reports/routing/*/cache/

# KiCad window state and transient locks are specific to each workstation.
*.kicad_prl
*.lck
~*.lck
*-backups/
.history/

# Owned process IDs and engine runtime profiles are not experiment evidence.
reports/routing/04-freerouting/mcp/owned-pid
reports/routing/04-freerouting/server-state/
reports/routing/04-freerouting/cli-state/
reports/routing/04-freerouting/cli-control/state/
reports/routing/04-freerouting/setup-attempts/*/state/
reports/firstz80/*/attempt-*/cache/
reports/firstz80/03-freerouting/mcp/owned-pid
reports/firstz80/03-freerouting/server-state/
